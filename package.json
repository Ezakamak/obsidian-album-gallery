{
  "name": "obsidian-album-gallery",
  "version": "0.6.8",
  "description": "An Apple Photos-inspired managed photo, GIF, and video album gallery plugin for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "validate:release": "node scripts/validate-release.mjs",
    "check": "npm run lint && npm run build && npm run validate:grid && npm run validate:lightbox && npm run validate:release",
    "prepare:release": "npm run check && node scripts/prepare-release.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "validate:grid": "node scripts/validate-mobile-grid.mjs",
    "validate:lightbox": "node scripts/validate-lightbox.mjs"
  },
  "keywords": [
    "obsidian",
    "gallery",
    "album",
    "photos",
    "gif",
    "video",
    "ios"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.17",
    "esbuild": "0.25.5",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.0",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "obsidian": "1.12.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2"
  }
}
